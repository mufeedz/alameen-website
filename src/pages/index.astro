    </div>
  </section>

</BaseLayout>


<!-- ══════════════════════════════════════════════════
     HERO SLIDER SCRIPT — no external dependencies
     Uses Astro's component script (hoisted, deduped)
     ══════════════════════════════════════════════════ -->
<script>
  const track   = document.getElementById('hero-track') as HTMLElement;
  const dots    = document.querySelectorAll('[id^="hero-dot-"]');
  const slides  = track?.children as HTMLCollectionOf<HTMLElement>;
  const total   = slides?.length ?? 0;
  let   current = 0;
  let   timer: ReturnType<typeof setInterval>;

  function goTo(index: number) {
    if (!track || total === 0) return;
    current = (index + total) % total;
    track.style.transform = `translateX(-${current * (100 / total)}%)`;

    // Update dots
    dots.forEach((dot, i) => {
      const isActive = i === current;
      dot.setAttribute('aria-selected', String(isActive));
      dot.classList.toggle('w-6',         isActive);
      dot.classList.toggle('bg-[var(--color-accent)]', isActive);
      dot.classList.toggle('w-2.5',       !isActive);
      dot.classList.toggle('bg-white/50', !isActive);
    });

    // Update aria-hidden on slides
    Array.from(slides).forEach((slide, i) => {
      slide.setAttribute('aria-hidden', String(i !== current));
    });
  }

  function startAutoplay() {
    stopAutoplay();
    timer = setInterval(() => goTo(current + 1), 5000);
  }
  function stopAutoplay() {
    clearInterval(timer);
  }

  // Wire controls
  document.getElementById('hero-prev')?.addEventListener('click', () => { goTo(current - 1); startAutoplay(); });
  document.getElementById('hero-next')?.addEventListener('click', () => { goTo(current + 1); startAutoplay(); });
  dots.forEach((dot, i) => {
    dot.addEventListener('click', () => { goTo(i); startAutoplay(); });
  });

  // Pause on hover
  track?.addEventListener('mouseenter', stopAutoplay);
  track?.addEventListener('mouseleave', startAutoplay);

  // Stop autoplay if user prefers reduced motion
  const mq = window.matchMedia('(prefers-reduced-motion: reduce)');
  if (!mq.matches) startAutoplay();
  mq.addEventListener('change', e => e.matches ? stopAutoplay() : startAutoplay());

  // Touch swipe support (for mid-range Android)
  let touchStartX = 0;
  track?.addEventListener('touchstart', (e) => { touchStartX = e.touches[0].clientX; }, { passive: true });
  track?.addEventListener('touchend',   (e) => {
    const delta = touchStartX - e.changedTouches[0].clientX;
    if (Math.abs(delta) > 50) { goTo(current + (delta > 0 ? 1 : -1)); startAutoplay(); }
  }, { passive: true });
</script>
